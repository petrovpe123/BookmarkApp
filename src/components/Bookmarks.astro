---
---

<section class="bookmark-card" aria-labelledby="bookmark-heading">
  <div class="card-copy">
    <p class="eyebrow">Local-first link saver</p>
    <h2 id="bookmark-heading">Create a Mona shortlink</h2>
    <p>Paste any URL format and Mona will normalize it, save it on this device, and mint a compact <code>mona-</code> slug.</p>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="off"
        spellcheck="false"
        placeholder="github.com/mona"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Bookmarks are private to this browser and render as <code>URL :: slug</code>.</p>
</section>

<section class="saved-card" aria-labelledby="saved-heading">
  <div id="list-header" hidden>
    <h2 id="saved-heading" class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
    <!-- Bookmarks render here in the browser. -->
  </ul>
</section>

<script>
  import { createBookmark, formatBookmark, parseStoredBookmarks } from './bookmarkHelpers';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  let bookmarks = loadBookmarks();

  renderBookmarks();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(input instanceof HTMLInputElement)) {
      return;
    }

    try {
      input.setCustomValidity('');
      const bookmark = createBookmark(input.value);
      bookmarks = [bookmark, ...bookmarks];
      saveBookmarks(bookmarks);
      renderBookmarks();
      form.reset();
      input.focus();
    } catch {
      input.setCustomValidity('Enter a valid HTTP or HTTPS URL.');
      input.reportValidity();
    }
  });

  clearAll?.addEventListener('click', () => {
    if (bookmarks.length === 0 || !confirm('Clear all saved Mona bookmarks?')) {
      return;
    }

    bookmarks = [];
    saveBookmarks(bookmarks);
    renderBookmarks();
  });

  function loadBookmarks() {
    try {
      return parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function saveBookmarks(nextBookmarks) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
    } catch {
      // Rendering still succeeds if storage is unavailable.
    }
  }

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) {
      return;
    }

    list.replaceChildren(...bookmarks.map(createBookmarkItem));
    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  function createBookmarkItem(bookmark) {
    const item = document.createElement('li');
    const value = document.createElement('span');
    const link = document.createElement('a');
    const separator = document.createElement('span');
    const text = document.createElement('span');
    const copy = document.createElement('button');

    item.className = 'bookmark';
    value.className = 'bookmark-value';
    link.className = 'url';
    link.href = bookmark.url;
    link.target = '_blank';
    link.rel = 'noreferrer';
    link.textContent = bookmark.url;
    separator.textContent = ' :: ';
    text.className = 'slug';
    text.textContent = bookmark.slug;
    value.setAttribute('aria-label', formatBookmark(bookmark));
    value.append(link, separator, text);
    copy.className = 'copy';
    copy.type = 'button';
    copy.textContent = 'Copy slug';
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bookmark.slug);
        copy.textContent = 'Copied';
      } catch {
        copy.textContent = 'Copy failed';
      } finally {
        setTimeout(() => {
          copy.textContent = 'Copy slug';
        }, 1200);
      }
    });

    item.append(value, copy);
    return item;
  }
</script>
